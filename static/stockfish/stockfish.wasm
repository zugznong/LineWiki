# 2. Overwrite this placeholder file with the actual raw binary output. 
# 3. Ensure cloudflare deployment MIME-type is configured for "application/wasm".
VERSION: Stockfish 16.1 WASM Binary Stub
BUILD_STAGE: OPEN_BETA_0
MIME: application/wasm
STATUS: READY_FOR_UPGRADE
